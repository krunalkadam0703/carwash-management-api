// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/////////////////////////////////////////////////////
// ENUMS
/////////////////////////////////////////////////////

enum UserRole {
  SYSTEM_ADMIN
  OWNER
  WORKER
  CUSTOMER
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ActivityStatus {
  CREATED
  WASHING
  COMPLETED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAYMENT_PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum WorkerLiveStatus {
  OFFLINE
  AVAILABLE
  BUSY
  ON_BREAK
}

enum WashScheduleStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  UNAVAILABLE
  CANCELLED
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum NotificationType {
  SUBSCRIPTION_REQUEST
  SUBSCRIPTION_APPROVED
  SUBSCRIPTION_REJECTED
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  VEHICLE_ASSIGNED
  VEHICLE_UNASSIGNED
  CAR_WASH_STARTED
  CAR_WASH_COMPLETED
  SUBSCRIPTION_EXPIRING
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

/////////////////////////////////////////////////////
// BUSINESS
/////////////////////////////////////////////////////

model Business {
  id          String  @id @default(uuid())
  name        String
  description String?
  ownerId     String  @unique

  owner              User                  @relation("BusinessOwner", fields: [ownerId], references: [id])
  users              User[]
  vehicleTypes       VehicleType[]
  services           Service[]
  plans              Plan[]
  vehicles           Vehicle[]
  subscriptions      VehicleSubscription[]
  bookings           Booking[]
  payments           Payment[]
  workerStatuses     WorkerStatus[]
  workerTaskQueues   WorkerTaskQueue[]
  dailyWashSchedules DailyWashSchedule[]
  subscriptionPauses SubscriptionPause[]
  complaints         Complaint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/////////////////////////////////////////////////////
// USER
/////////////////////////////////////////////////////

model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  role             UserRole @default(CUSTOMER)
  phoneNumber      String?
  address          String?
  currentLocation  String?
  emergencyContact String?
  photoUrl         String?
  isActive         Boolean  @default(true)
  businessId       String?

  business              Business?                 @relation(fields: [businessId], references: [id])
  sessions              Session[]
  accounts              Account[]
  ownedBusiness         Business?                 @relation("BusinessOwner")
  vehicles              Vehicle[]                 @relation("CustomerVehicles")
  bookings              Booking[]
  workerAssignments     WorkerAssignment[]
  workerActivities      ActivityLog[]             @relation("WorkerActivities")
  customerActivities    ActivityLog[]             @relation("CustomerActivities")
  approvedSubscriptions VehicleSubscription[]     @relation("SubscriptionApprover")
  customerSubscriptions VehicleSubscription[]     @relation("CustomerSubscriptions")
  approvalLogs          SubscriptionApprovalLog[]
  notifications         Notification[]
  createdAssignments    WorkerAssignment[]        @relation("AssignmentCreator")
  workerBookings        Booking[]                 @relation("WorkerBookings")
  payments              Payment[]                 @relation("CustomerPayments")
  workerStatus          WorkerStatus?
  workerTaskQueues      WorkerTaskQueue[]
  dailyWashSchedules    DailyWashSchedule[]       @relation("CustomerDailyWashSchedules")
  subscriptionPauses    SubscriptionPause[]       @relation("CustomerSubscriptionPauses")
  complaints            Complaint[]               @relation("CustomerComplaints")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([role])
}

/////////////////////////////////////////////////////
// BETTER AUTH
/////////////////////////////////////////////////////

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

/////////////////////////////////////////////////////
// VEHICLE TYPE
/////////////////////////////////////////////////////

model VehicleType {
  id         String  @id @default(uuid())
  businessId String
  name       String
  slug       String
  examples   String?
  icon       String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  business Business  @relation(fields: [businessId], references: [id])
  services Service[]
  plans    Plan[]
  vehicles Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@unique([businessId, slug])
}

/////////////////////////////////////////////////////
// SERVICE
/////////////////////////////////////////////////////

model Service {
  id              String  @id @default(uuid())
  businessId      String
  vehicleTypeId   String
  name            String
  description     String?
  basePrice       Decimal @db.Decimal(10, 2)
  durationMinutes Int     @default(45)
  isActive        Boolean @default(true)

  business     Business       @relation(fields: [businessId], references: [id])
  vehicleType  VehicleType    @relation(fields: [vehicleTypeId], references: [id])
  planServices PlanService[]
  bookings     Booking[]
  images       ServiceImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceImage {
  id        String   @id @default(uuid())
  serviceId String
  imageUrl  String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

/////////////////////////////////////////////////////
// PLAN
/////////////////////////////////////////////////////

model Plan {
  id               String  @id @default(uuid())
  businessId       String
  vehicleTypeId    String
  name             String
  description      String?
  category         String?
  price            Decimal @db.Decimal(10, 2)
  durationDays     Int
  washesTotal      Int     @default(0)
  validityDays     Int?
  durationMonths   Int?
  dailyWash        Boolean @default(true)
  isFeatured       Boolean @default(false)
  isActive         Boolean @default(true)
  interiorCleaning Boolean @default(false)
  foamWash         Boolean @default(false)
  ceramicCoating   Boolean @default(false)

  business               Business              @relation(fields: [businessId], references: [id])
  vehicleType            VehicleType           @relation(fields: [vehicleTypeId], references: [id])
  services               PlanService[]
  subscriptions          VehicleSubscription[]
  suggestedSubscriptions VehicleSubscription[] @relation("SuggestedSubscriptionPlan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
}

/////////////////////////////////////////////////////
// PLAN SERVICE
/////////////////////////////////////////////////////

model PlanService {
  id        String @id @default(uuid())
  planId    String
  serviceId String

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([planId, serviceId])
}

/////////////////////////////////////////////////////
// VEHICLE
/////////////////////////////////////////////////////

model Vehicle {
  id            String  @id @default(uuid())
  businessId    String
  customerId    String
  vehicleTypeId String
  vehicleNumber String
  vehicleName   String?
  brand         String?
  model         String?
  color         String?
  location      String?

  business           Business              @relation(fields: [businessId], references: [id])
  customer           User                  @relation("CustomerVehicles", fields: [customerId], references: [id])
  vehicleType        VehicleType           @relation(fields: [vehicleTypeId], references: [id])
  photos             VehiclePhoto[]
  subscriptions      VehicleSubscription[]
  bookings           Booking[]
  assignments        WorkerAssignment[]
  activityLogs       ActivityLog[]
  dailyWashSchedules DailyWashSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, vehicleNumber])
}

/////////////////////////////////////////////////////
// VEHICLE PHOTO
/////////////////////////////////////////////////////

model VehiclePhoto {
  id        String  @id @default(uuid())
  vehicleId String
  imageUrl  String
  caption   String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

/////////////////////////////////////////////////////
// VEHICLE SUBSCRIPTION
/////////////////////////////////////////////////////

model VehicleSubscription {
  id                  String             @id @default(uuid())
  businessId          String
  customerId          String
  vehicleId           String
  planId              String
  suggestedPlanId     String?
  status              SubscriptionStatus @default(REQUESTED)
  requestedAt         DateTime           @default(now())
  approvedAt          DateTime?
  approvedById        String?
  rejectedAt          DateTime?
  rejectionReason     String?
  startDate           DateTime?
  endDate             DateTime?
  amount              Decimal            @db.Decimal(10, 2)
  autoRenew           Boolean            @default(false)
  washesUsed          Int                @default(0)
  // FIX: was incorrectly defaulted to true
  expiryReminderSent  Boolean            @default(false)
  renewalReminderSent Boolean            @default(false)

  business           Business                  @relation(fields: [businessId], references: [id])
  customer           User                      @relation("CustomerSubscriptions", fields: [customerId], references: [id])
  vehicle            Vehicle                   @relation(fields: [vehicleId], references: [id])
  plan               Plan                      @relation(fields: [planId], references: [id])
  suggestedPlan      Plan?                     @relation("SuggestedSubscriptionPlan", fields: [suggestedPlanId], references: [id])
  approvedBy         User?                     @relation("SubscriptionApprover", fields: [approvedById], references: [id])
  payments           Payment[]
  bookings           Booking[]
  dailyWashSchedules DailyWashSchedule[]
  pauses             SubscriptionPause[]
  approvalLogs       SubscriptionApprovalLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([businessId, customerId])
  @@index([vehicleId])
}

/////////////////////////////////////////////////////
// PAYMENT (RAZORPAY)
/////////////////////////////////////////////////////

model Payment {
  id                String        @id @default(uuid())
  businessId        String
  customerId        String
  subscriptionId    String?
  bookingId         String?
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  paymentMethod     String?
  upiRef            String?
  receiptId         String?       @unique
  currency          String        @default("INR")
  failureReason     String?
  paidAt            DateTime?

  business     Business             @relation(fields: [businessId], references: [id])
  customer     User                 @relation("CustomerPayments", fields: [customerId], references: [id])
  subscription VehicleSubscription? @relation(fields: [subscriptionId], references: [id])
  booking      Booking?             @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([businessId, customerId])
}

/////////////////////////////////////////////////////
// SUBSCRIPTION APPROVAL LOG
/////////////////////////////////////////////////////

model SubscriptionApprovalLog {
  id             String  @id @default(uuid())
  subscriptionId String
  performedById  String
  action         String
  remarks        String?

  subscription VehicleSubscription @relation(fields: [subscriptionId], references: [id])
  performedBy  User                @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())
}

/////////////////////////////////////////////////////
// BOOKING
/////////////////////////////////////////////////////

model Booking {
  id             String        @id @default(uuid())
  businessId     String
  customerId     String
  vehicleId      String
  serviceId      String?
  subscriptionId String?
  workerId       String?
  receiptNumber  String?       @unique
  scheduledDate  DateTime
  amount         Decimal?      @db.Decimal(10, 2)
  address        String?
  notes          String?
  status         BookingStatus @default(PENDING)
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  skipReason     String?
  rating         Int?
  ratingComment  String?
  priority       Int           @default(0)
  queueDate      DateTime?

  business              Business             @relation(fields: [businessId], references: [id])
  customer              User                 @relation(fields: [customerId], references: [id])
  vehicle               Vehicle              @relation(fields: [vehicleId], references: [id])
  service               Service?             @relation(fields: [serviceId], references: [id])
  subscription          VehicleSubscription? @relation(fields: [subscriptionId], references: [id])
  worker                User?                @relation("WorkerBookings", fields: [workerId], references: [id])
  payments              Payment[]
  workerTaskQueue       WorkerTaskQueue?
  dailyWashSchedules    DailyWashSchedule[]
  complaints            Complaint[]
  currentWorkerStatuses WorkerStatus[]       @relation("CurrentWorkerBooking")

  createdAt DateTime @default(now())

  @@index([businessId, scheduledDate])
  @@index([status])
}

model WorkerStatus {
  workerId         String           @id
  businessId       String
  status           WorkerLiveStatus @default(OFFLINE)
  currentBookingId String?
  freeAt           DateTime?
  area             String?
  rating           Decimal?         @db.Decimal(3, 2)
  jobsCompleted    Int              @default(0)
  updatedAt        DateTime         @updatedAt

  worker         User     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  business       Business @relation(fields: [businessId], references: [id])
  currentBooking Booking? @relation("CurrentWorkerBooking", fields: [currentBookingId], references: [id])

  @@index([businessId, status])
}

model WorkerTaskQueue {
  id         String   @id @default(uuid())
  businessId String
  workerId   String
  bookingId  String   @unique
  queueDate  DateTime
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  worker   User     @relation(fields: [workerId], references: [id])
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([workerId, queueDate, position])
  @@index([businessId, queueDate])
}

/////////////////////////////////////////////////////
// WORKER ASSIGNMENT
/////////////////////////////////////////////////////

model WorkerAssignment {
  id           String           @id @default(uuid())
  // FIX: assignedById was missing as a declared field
  assignedById String?
  workerId     String
  vehicleId    String
  status       AssignmentStatus @default(PENDING)
  assignedAt   DateTime         @default(now())
  completedAt  DateTime?

  assignedBy User?   @relation("AssignmentCreator", fields: [assignedById], references: [id])
  worker     User    @relation(fields: [workerId], references: [id])
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
}

/////////////////////////////////////////////////////
// ACTIVITY LOG
/////////////////////////////////////////////////////

model ActivityLog {
  id          String         @id @default(uuid())
  workerId    String
  customerId  String
  vehicleId   String
  status      ActivityStatus
  reason      String?
  remarks     String?
  startedAt   DateTime?
  completedAt DateTime?

  worker   User            @relation("WorkerActivities", fields: [workerId], references: [id])
  customer User            @relation("CustomerActivities", fields: [customerId], references: [id])
  vehicle  Vehicle         @relation(fields: [vehicleId], references: [id])
  photos   ActivityPhoto[]

  createdAt DateTime @default(now())
}

/////////////////////////////////////////////////////
// NOTIFICATION
/////////////////////////////////////////////////////

model Notification {
  id        String             @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  status    NotificationStatus @default(UNREAD)
  actionUrl String?
  metadata  Json?
  readAt    DateTime?

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/////////////////////////////////////////////////////
// NOTIFICATION DELIVERY
/////////////////////////////////////////////////////

model NotificationDelivery {
  id             String              @id @default(uuid())
  notificationId String
  channel        NotificationChannel
  delivered      Boolean             @default(false)
  deliveredAt    DateTime?
  errorMessage   String?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([notificationId])
}

/////////////////////////////////////////////////////
// AUDIT LOG
/////////////////////////////////////////////////////

model AuditLog {
  id         String  @id @default(uuid())
  businessId String?
  userId     String?
  action     String
  entityType String
  entityId   String
  oldData    Json?
  newData    Json?

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([entityType, entityId])
}

/////////////////////////////////////////////////////
// ACTIVITY PHOTO
/////////////////////////////////////////////////////

model ActivityPhoto {
  id            String  @id @default(uuid())
  activityLogId String
  imageUrl      String
  photoType     String?

  activityLog ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model DailyWashSchedule {
  id                String             @id @default(uuid())
  businessId        String
  subscriptionId    String
  customerId        String
  vehicleId         String
  bookingId         String?
  washDate          DateTime
  status            WashScheduleStatus @default(SCHEDULED)
  unavailableReason String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  business     Business            @relation(fields: [businessId], references: [id])
  subscription VehicleSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  customer     User                @relation("CustomerDailyWashSchedules", fields: [customerId], references: [id])
  vehicle      Vehicle             @relation(fields: [vehicleId], references: [id])
  booking      Booking?            @relation(fields: [bookingId], references: [id])

  @@unique([subscriptionId, washDate])
  @@index([businessId, washDate])
  @@index([status])
}

model SubscriptionPause {
  id             String   @id @default(uuid())
  businessId     String
  subscriptionId String
  customerId     String
  startDate      DateTime
  endDate        DateTime
  reason         String?
  createdAt      DateTime @default(now())

  business     Business            @relation(fields: [businessId], references: [id])
  subscription VehicleSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  customer     User                @relation("CustomerSubscriptionPauses", fields: [customerId], references: [id])

  @@index([businessId, startDate, endDate])
}

model Complaint {
  id         String          @id @default(uuid())
  businessId String
  customerId String
  bookingId  String?
  subject    String
  message    String
  status     ComplaintStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  customer User     @relation("CustomerComplaints", fields: [customerId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@index([businessId, status])
}

model RazorpayWebhookEvent {
  id           String    @id @default(uuid())
  eventId      String    @unique
  eventType    String
  payload      Json
  processed    Boolean   @default(false)
  errorMessage String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?
}
