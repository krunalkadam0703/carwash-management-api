# Copy this file to /opt/mudwashers/.env on the VPS.
# Replace every CHANGE_ME value before running docker compose.

# Docker images pulled by docker-compose.yml
API_IMAGE=CHANGE_ME_DOCKERHUB_USERNAME/mudwashers-api:latest
WEB_IMAGE=CHANGE_ME_DOCKERHUB_USERNAME/mudwashers-web:latest

# Runtime
NODE_ENV=production
PORT=5000
WEB_CONCURRENCY=1

# Database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=carwash_db
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/carwash_db?schema=public

# Auth
BETTER_AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
BETTER_AUTH_URL=https://api.mudwashers.com
BETTER_AUTH_TRUSTED_ORIGINS=https://mudwashers.com,https://www.mudwashers.com
COOKIE_SAME_SITE=none
COOKIE_SECRET=CHANGE_ME_LONG_RANDOM_COOKIE_SECRET

# Optional Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay
RAZORPAY_KEY_ID=CHANGE_ME_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET

# Redis container
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
